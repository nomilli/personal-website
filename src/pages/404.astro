---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Not found" description="That page couldn't be found.">
  <section class="section">
    <div class="container" style="text-align:center; padding-block:3rem;">
      <p class="eyebrow">404</p>
      <h1>This bench is empty</h1>
      <p class="muted">The page you're looking for doesn't exist (or moved).</p>
      <p style="margin-top:1.5rem;">
        <a class="btn btn-primary" href="/">Back home</a>
      </p>
    </div>
  </section>
</BaseLayout>
