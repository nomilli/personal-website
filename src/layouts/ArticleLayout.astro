---
import BaseLayout from "./BaseLayout.astro";

interface Props {
  title: string;
  description?: string;
  pubDate: Date;
  updatedDate?: Date;
  cover?: string;
  coverAlt?: string;
  category?: string;
  status?: string;
  tags?: string[];
  backHref: string;
  backLabel: string;
  /** Optional "part of <project>" context link, shown above the title. */
  projectHref?: string;
  projectTitle?: string;
}

const {
  title,
  description,
  pubDate,
  updatedDate,
  cover,
  coverAlt,
  category,
  status,
  tags = [],
  backHref,
  backLabel,
  projectHref,
  projectTitle,
} = Astro.props;

const fmt = (d: Date) =>
  d.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric", timeZone: "UTC" });
---

<BaseLayout title={title} description={description} image={cover}>
  <article class="section">
    <div class="container">
      <a class="back" href={backHref}>← {backLabel}</a>

      <header class="article-head">
        {
          projectHref && projectTitle && (
            <p class="article-project">
              Build log · <a href={projectHref}>{projectTitle}</a>
            </p>
          )
        }
        <div class="article-meta">
          {category && <span>{category}</span>}
          {status && <span class="chip chip-status" data-status={status}>{status.replace("-", " ")}</span>}
          <span>{fmt(pubDate)}</span>
          {updatedDate && <span>· updated {fmt(updatedDate)}</span>}
        </div>
        <h1>{title}</h1>
        {description && <p class="article-lead">{description}</p>}
        {
          tags.length > 0 && (
            <div class="tag-row article-tags">
              {tags.map((t) => (
                <span class="chip">#{t}</span>
              ))}
            </div>
          )
        }
      </header>

      {
        cover && (
          <figure class="article-cover">
            <img src={cover} alt={coverAlt ?? ""} />
          </figure>
        )
      }

      <div class="prose">
        <slot />
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .back {
    display: inline-block;
    text-decoration: none;
    font-weight: 600;
    font-size: 0.95rem;
    margin-bottom: 1.5rem;
  }
  .article-head {
    max-width: var(--measure-prose);
    margin-inline: auto;
  }
  .article-project {
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--rust);
    margin: 0 0 0.6rem;
  }
  .article-project a {
    color: inherit;
  }
  .article-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 0.9rem;
    align-items: center;
    color: var(--ink-faint);
    font-size: 0.9rem;
    margin-bottom: 0.6rem;
  }
  .article-lead {
    font-size: 1.2rem;
    color: var(--ink-soft);
    margin: 0.4rem 0 0;
  }
  .article-tags {
    margin-top: 1rem;
  }
  .article-cover {
    max-width: var(--measure);
    margin: 2rem auto;
  }
  .article-cover img {
    width: 100%;
    border-radius: var(--radius-lg);
    border: 1px solid var(--line);
  }
</style>
