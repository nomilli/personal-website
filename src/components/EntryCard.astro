---
interface Props {
  href: string;
  title: string;
  excerpt?: string;
  date?: Date;
  cover?: string;
  coverAlt?: string;
  category?: string;
  status?: string;
  tags?: string[];
}

const { href, title, excerpt, date, cover, coverAlt, category, status, tags = [] } =
  Astro.props;

const dateStr = date
  ? date.toLocaleDateString("en-US", {
      year: "numeric",
      month: "short",
      day: "numeric",
      timeZone: "UTC",
    })
  : undefined;
---

<article class="card">
  <a class="card-link" href={href}>
    {
      cover && (
        <div class="card-media">
          <img src={cover} alt={coverAlt ?? ""} loading="lazy" />
        </div>
      )
    }
    <div class="card-body">
      <div class="card-meta">
        {category && <span>{category}</span>}
        {status && <span class="chip chip-status" data-status={status}>{status.replace("-", " ")}</span>}
        {dateStr && <span>{dateStr}</span>}
      </div>
      <h3 class="card-title">{title}</h3>
      {excerpt && <p class="card-excerpt">{excerpt}</p>}
      {
        tags.length > 0 && (
          <div class="tag-row">
            {tags.slice(0, 4).map((t) => (
              <span class="chip">#{t}</span>
            ))}
          </div>
        )
      }
    </div>
  </a>
</article>
